# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "mock" is the only provider for now (see src/lib/payments)
PAYMENT_PROVIDER=mock

# Exchange rates: "stored" reads admin-managed rates from the database (see src/lib/fx)
EXCHANGE_RATE_PROVIDER=stored

# Email: "console" logs emails to the server log; "resend" sends via Resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="FundMyDegree <no-reply@fundmydegree.org>"

# Shared secret for the scheduled job endpoint (/api/cron/daily)
CRON_SECRET=change-me
